# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars (it contains secrets)

aws_account_id      = "184353710603"
aws_region          = "ap-southeast-1"
domain              = "api.apexaegis.app"
gateway_domain      = "gateway-api.apexaegis.app"
device_domain       = "device-api.apexaegis.app"

# Get this from AWS Certificate Manager after requesting a cert for api.apexaegis.app
# Must be in ap-southeast-1 (same region as ALB)
acm_certificate_arn = "arn:aws:acm:ap-southeast-1:184353710603:certificate/REPLACE-ME"

# Optional. Leave empty when acm_certificate_arn is a wildcard/SAN cert that
# covers both api.apexaegis.app and gateway-api.apexaegis.app.
gateway_acm_certificate_arn = ""
device_acm_certificate_arn  = ""

# Required for the gateway-only gRPC listener. Create this from the ACM PCA /
# gateway CA trust bundle so ALB can verify gateway client certificates.
gateway_trust_store_arn = "arn:aws:elasticloadbalancing:ap-southeast-1:184353710603:truststore/REPLACE-ME"

# Required for desktop/mobile REST mTLS. Create this from the AWS Private CA /
# device CA trust bundle used by MDM/Jamf/Intune provisioned device certs.
device_trust_store_arn = "arn:aws:elasticloadbalancing:ap-southeast-1:184353710603:truststore/REPLACE-ME"

# Your CockroachDB Cloud connection string (same one in Railway today)
database_url        = "postgresql://..."

# Same JWT secret you have in Railway today
jwt_secret          = "your-jwt-secret"

# Gateway shared API key (same as in gateway terraform.tfvars)
gateway_api_key     = "ee94927bca7b0777880e7336aa2127d4a2d14a627dd6b3a4f2afffd8140df81b"

# Fargate sizing (0.5 vCPU / 1GB is plenty for demo)
task_cpu            = 512
task_memory         = 1024
desired_count       = 1

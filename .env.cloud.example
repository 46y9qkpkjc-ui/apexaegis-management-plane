# ============================================================
# ApexAegis Management Plane — CockroachDB Cloud Environment
# ============================================================
# Copy to .env and fill in your CockroachDB Cloud credentials.
# Get your connection string from:
#   CockroachDB Cloud Console → Cluster → Connect → Connection string
# ============================================================

# ── CockroachDB Cloud (REQUIRED) ──────────────────────────────
# Format: postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
DATABASE_URL="postgresql://apexaegis_user:g_MT5YJBqN0ii5srFxuUEg@apexaegis-db-26909.j77.aws-ap-southeast-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Path to SQL migration files (relative to working directory)
MIGRATIONS_DIR="internal/db/migrations"

# ── Security (REQUIRED) ──────────────────────────────────────
VAULT_PASSPHRASE="change-me-in-production"
VAULT_STORE_PATH="/etc/apexaegis/vault"

# JWT signing secret for user authentication (32+ chars, random)
JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ── Organization Plan ────────────────────────────────────────
ORG_PLAN="enterprise"

# ── Server Addresses ─────────────────────────────────────────
LISTEN_ADDR=":9090"
MTLS_LISTEN_ADDR=":9443"
GRPC_LISTEN_ADDR=":9444"
DEPLOY_MODE="cloud"

# ── TLS Certificates ─────────────────────────────────────────
# CA_CERT_FILE="/etc/apexaegis/certs/ca.crt"
# CA_KEY_FILE="/etc/apexaegis/certs/ca.key"
# GRPC_CERT_FILE="/etc/apexaegis/certs/grpc.crt"
# GRPC_KEY_FILE="/etc/apexaegis/certs/grpc.key"
